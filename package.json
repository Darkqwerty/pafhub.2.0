 {
  "name": "pafhub",
  "version": "0.1.0",
  "private": true,
  "description": "A game discovery hub with a React client and TypeScript API server.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "start": "npm --workspace server run start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
