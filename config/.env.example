# API credentials stay on the server. Leave blank to use the demo catalog.
CLIENT_ORIGIN=http://localhost:8080
RAWG_API_KEY=
STEAM_API_KEY=
STEAM_ID=

# Epic Games needs no environment variable: authorize the account from the
# Settings dialog, which stores a refresh token in db/settings.json.

# F95Zone needs no environment variable: thread metadata is public and imported
# without any account credentials.
