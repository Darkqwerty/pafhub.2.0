NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:8080

# Keep provider credentials server-side. Leave blank while using the demo catalog.
RAWG_API_KEY=
STEAM_API_KEY=
STEAM_ID=

# Epic Games needs no environment variable: set the OAuth client ID/secret and
# authorize the account in the Settings dialog; they are stored in db/settings.json.

# F95Zone needs no environment variable: thread metadata is public and imported
# without any account credentials.
